</t>
<t t-if="currency_id.position == 'before'">
^A0N,66,48^FH^FD<t t-esc="currency_id.name"/><t t-esc="pricelist._get_product_price(product, 1, currency_id)" t-options='{"widget": "float", "precision": 2}'/>^FS
</t>
</t>
<t t-if="barcode">
^FO150,950^BY3
^BCN,100,Y,N,N
^FD<t t-out="barcode"/>^FS
</t>

<t t-call="jt_eauzon_custom.zpl_eauzon_footer"/>
