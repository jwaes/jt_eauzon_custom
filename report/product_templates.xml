<odoo>

    <template id="label_product_product_view" name="Eauzon product Label" inherit_id="stock.label_product_product_view">
        <xpath expr="//t[@t-as='qty']" position="replace">
            <t t-foreach="range(product_info['quantity'])" t-as="qty">
                <t t-translation="off">

<t t-call="jt_eauzon_custom.zpl_eauzon_header"/>

^FO30,330^ADN,36,20^FB770,5,20,L,0^FD<t t-out="product_info['display_name_markup']"/>^FS



